# Скопируйте этот файл в .env и заполните реальными значениями.
# На Render.com эти же переменные задаются в разделе Environment, .env туда заливать не нужно.

DISCORD_TOKEN=вставьте_сюда_токен_вашего_бота

# Необязательно: Render сам подставляет PORT, локально можно не указывать.
# PORT=8080

# Необязательно: путь к файлу базы данных (по умолчанию database.json)
# DB_PATH=database.json
